# Raw and processed data are regenerated by `python -m dinesafe run`
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/excel/*.csv

# Generated dashboard data bundle (~10 MB, changes daily)
dashboard/data/*
!dashboard/data/.gitkeep

# Jupyter notebook checkpoints
**/.ipynb_checkpoints/

# Python
__pycache__/
*.egg-info/
.pytest_cache/
build/

# System files
.DS_Store

venv/
.venv/
